# Dedicated Gmail account for the agent. Use an App Password (2FA required).
AGENT_EMAIL=agent.mailbox@gmail.com
AGENT_EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Seconds between inbox polls
POLL_INTERVAL_SECONDS=15

# Hard cap on files per request (assignment says 10)
MAX_FILES=10

# Binary ZIP budget. The lower value leaves room for MIME/base64 expansion.
MAX_ATTACHMENT_BYTES=17000000

# Maximum size of the fully encoded SMTP message.
MAX_MESSAGE_BYTES=24000000

# Oversized inbound messages are ignored before their MIME bodies are downloaded.
MAX_INBOUND_BYTES=1000000

# Per-download timeout in seconds
DOWNLOAD_TIMEOUT_SECONDS=120
NETWORK_TIMEOUT_SECONDS=30

# Parallel browser jobs and per-sender abuse protection.
MAX_WORKERS=2
RATE_LIMIT_PER_SENDER_HOUR=10
GLOBAL_RATE_LIMIT_PER_HOUR=50

# Active jobs older than this are considered abandoned after a restart.
STALE_REQUEST_SECONDS=1800

# SQLite state database path
STATE_DB_PATH=state.db

# Working directory for per-request temp downloads and ZIPs
WORK_DIR=work

# Set to 0 to watch the browser
HEADLESS=1

UARB_URL=https://uarb.novascotia.ca/fmi/webd/UARB15
